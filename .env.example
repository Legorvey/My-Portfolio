# Environment Configuration Template
# Copy to .env.local for local overrides

# Case Studies Feature Gate
# - "true"  : Expose individual case study pages (/projects/[slug]) and clickable links across the portfolio
# - "false" : Block case studies for MVP release (returns 404 and renders unlinked card headers)
# Default behavior if unset: true in development/test, false in production.
NEXT_PUBLIC_ENABLE_CASE_STUDIES=false
